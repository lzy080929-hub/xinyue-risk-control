# Copy this file to .env for local development. Never commit the real .env.
# Values below are intentionally empty placeholders, not usable credentials.

# development (default) or production. Production fails closed unless
# DATABASE_URL, SECRET_KEY, ADMIN_USERNAME, and ADMIN_PASSWORD_HASH are set.
APP_ENV=development

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Leave empty in development to use instance/xinyue-dev.sqlite3.
# Production must use a persistent PostgreSQL URL, for example:
# DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_URL=

# Create the password hash with: python scripts/hash_admin_password.py
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Optional local HTTP server settings.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Test sessions (TEST- prefix) are enabled by default only in development.
# Set to 0 to disable even locally. Production defaults to disabled.
ALLOW_TEST_MODE=1
